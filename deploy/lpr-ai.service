[Unit]
Description=LPR AI - nhờ AI xem lại người có thể trùng và biển số khó đọc
After=lpr-worker.service

[Service]
WorkingDirectory=%h/lpr-server
EnvironmentFile=%h/lpr-server/.env
ExecStart=%h/lpr-server/.venv/bin/python -W ignore -u ai.py
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
