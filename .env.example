# Cấu hình chạy, install.sh chép thành .env. .env chứa mật khẩu: không đưa lên git.
# Telegram, AI (OpenRouter), giờ cảnh báo… chỉnh trên web ở trang Cài đặt, không cần sửa ở đây.
# Lưu ý: chú thích phải nằm trên dòng riêng (systemd không hiểu chú thích ở cuối dòng).

# Web. Tài khoản admin đầu tiên được tạo từ WEB_USER / WEB_PASSWORD lúc chạy lần đầu.
# Sau đó đổi mật khẩu và thêm tài khoản trên web (menu Thêm → Đổi mật khẩu / Người dùng), sửa ở đây không còn tác dụng.
WEB_PORT=8080
WEB_USER=admin
WEB_PASSWORD=123456Aa@
# Đăng nhập được nhớ bao nhiêu ngày
# WEB_SESSION_DAYS=3650
# Địa chỉ web xem từ xa (vd. https://camera.tenmien.com): tin Telegram có nút mở video đúng lúc xảy ra
# LPR_PUBLIC_URL=

# Dữ liệu: SQLite + ảnh (biển số, khuôn mặt, người qua lại)
LPR_DATA_DIR=/home/USER/lpr-server/data
# Xoá ảnh / lượt cũ hơn số ngày này
LPR_RETENTION_DAYS=30
# Giới hạn dung lượng ảnh (MB), đầy thì xoá cũ nhất trước
LPR_MAX_IMAGES_MB=1000

# Tinh chỉnh nhận diện (thường không cần đổi):
# độ chắc tối thiểu của OCR biển số
# LPR_MIN_SCORE=0.7
# số lần đọc trùng nhau mới ghi nhận biển
# LPR_VOTES=3
# ngưỡng nhận ra khuôn mặt đã đăng ký
# LPR_FACE_MATCH=0.42
# ngưỡng gộp "người qua lại" là cùng một người
# LPR_REID_MATCH=0.88

# Chia lượt xử lý (5 camera trên CPU 6 nhân: 0.2 là vừa). Số giây tối thiểu mỗi vòng quét các camera
# LPR_INTERVAL=0.5
# camera được nhiều lượt hơn mỗi vòng, vd. camera cổng đọc biển số: "cong:4,san:2" (camera không ghi = 1 lượt)
# LPR_PRIORITY_CAMS=

# Các tuỳ chọn theo từng camera (ghi tên camera như trong go2rtc, cách nhau bằng dấu phẩy; để trống = tắt):
# bỏ lần đọc biển của xe đỗ lâu một chỗ, gộp lần đọc trùng (camera cổng nhìn thẳng)
# LPR_PLATE_TIDY_CAMS=
# chỉ gộp một xe bị tách thành 2 lần đi qua
# LPR_PLATE_MERGE_CAMS=
# camera Wi-Fi yếu hay rớt: ghi hình nối lại nhanh hơn
# LPR_FAST_RETRY_CAMS=
# camera Wi-Fi yếu: xem trực tiếp không kèm tiếng để hình không bị trễ (ghi hình vẫn có tiếng)
# LPR_LIVE_NO_AUDIO=
# camera Xiaomi có thẻ nhớ: tự chép bù đoạn ghi hình bị mất từ thẻ nhớ (cần go2rtc bản sửa, xem go2rtc/src/README.md)
# LPR_BACKFILL_CAMS=
